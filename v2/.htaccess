Options -Indexes -MultiViews
RewriteEngine On
RewriteBase /v2/
# Clean URLs
RewriteRule ^(services|portfolio|pricing|contact)/?$ $1.php [L,QSA]
# Hide raw .php URLs for pages
RewriteCond %{THE_REQUEST} \s/v2/(services|portfolio|pricing|contact)\.php[\s?] [NC]
RewriteRule ^ /v2/%1 [R=301,L]
ErrorDocument 404 /v2/404.php
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml
</IfModule>
<IfModule mod_mime.c>
    AddType text/javascript .js
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
</IfModule>
<FilesMatch "^(config|router)\.php$">
    Require all denied
</FilesMatch>
